CI_ENVIRONMENT = production
app.baseURL = 'https://test-cloud.pesonawifi.my.id/'
app.forceGlobalSecureRequests = true
database.default.hostname = localhost
database.default.database = pesona_cloud_drive
database.default.username = pcd_user
database.default.password = CHANGE_THIS
database.default.DBDriver = MySQLi
database.default.port = 3306
storage.privatePath = '/www/wwwroot/test-cloud.pesonawifi.my.id-private'
storage.xAccelEnabled = false

# SMTP untuk fitur lupa/reset password
email.fromEmail = 'no-reply@example.com'
email.fromName = 'Pesona Cloud Drive'
email.SMTPHost = 'smtp.example.com'
email.SMTPUser = 'no-reply@example.com'
email.SMTPPass = 'GANTI_DENGAN_PASSWORD_SMTP'
email.SMTPPort = 587
email.SMTPCrypto = 'tls'
